# GA4 (components/Analytics.tsx). Leave empty to ship no tag at all.
# Set in Vercel (Production) once the GA4 property exists; the same property
# id (numeric form, e.g. properties/123…) also goes in the cmd-bananas
# stratum tenant so the platform can pull metrics via the Data API.
NEXT_PUBLIC_GA4_ID=

# Contact form → email via Resend (app/api/contact/route.ts).
# On Vercel: install the Resend native integration from the Vercel Marketplace
# (Storage/Integrations tab) — it provisions the account and injects
# RESEND_API_KEY automatically. Then verify stratumtech.ca in Resend
# (SPF/DKIM DNS records) and set CONTACT_FROM_EMAIL to that domain; until
# then the onboarding@resend.dev default only delivers to the Resend
# account owner's own address.
# FROM must be on a Resend-verified domain. Stopgap while stratumtech.ca isn't
# verified: send from the agency's already-verified vectorspace.digital (the
# customer never sees this — reply_to is set to their own address). Switch to a
# stratumtech.ca sender once that domain is verified in Resend.
# CONTACT_TO_EMAIL has no default — set the real recipient in Vercel only; with
# it unset the route logs and returns 503 rather than mailing a guessed address.
# (Moot while /contact ships the HubSpot embed, which posts straight to the CRM.)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Stratum Website <notify@vectorspace.digital>"

# Magic-link sign-in for the internal tools under /internal (middleware.ts +
# lib/internal-auth.ts). Signs both the emailed link and the session cookie.
# Unset = /internal stays locked for everyone, which is the safe default.
# Generate with:  openssl rand -base64 32
# Rotating this signs everyone out.
INTERNAL_AUTH_SECRET=
# Who may request a sign-in link. Comma-separated; each entry is either a whole
# domain (stratumtech.ca) or one exact address (someone@agency.example), so an
# outside collaborator can be let in without opening up their whole domain.
# Defaults to stratumtech.ca.
INTERNAL_ALLOWED_EMAILS=stratumtech.ca
# Sign-in links are sent through the same Resend setup as the contact form
# (RESEND_API_KEY + CONTACT_FROM_EMAIL below). In `next dev` with no Resend key
# the link is printed to the terminal and shown on the page instead of emailed,
# so /internal is testable locally without a live key. That fallback is gated to
# NODE_ENV=development — a production deploy missing its key errors instead.

# Notion → Insights build pipeline. Copy to .env.local and fill NOTION_TOKEN.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=3de72646-a2a5-41f9-9d23-5208fd336e48
# "Signature CTA" database — feeds the email-signature builder's banner.
# Optional (the sync defaults to this id). The NOTION_TOKEN integration must be
# shared on this database, same as the Stratum News one.
NOTION_CTA_DATA_SOURCE_ID=c24ede1b-5671-46c3-b37d-c56e5516a2ec
