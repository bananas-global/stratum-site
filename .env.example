# Contact form → email via Resend (app/api/contact/route.ts).
# On Vercel: install the Resend native integration from the Vercel Marketplace
# (Storage/Integrations tab) — it provisions the account and injects
# RESEND_API_KEY automatically. Then verify stratumtech.ca in Resend
# (SPF/DKIM DNS records) and set CONTACT_FROM_EMAIL to that domain; until
# then the onboarding@resend.dev default only delivers to the Resend
# account owner's own address.
RESEND_API_KEY=
CONTACT_TO_EMAIL=bruce.santos@gmail.com
CONTACT_FROM_EMAIL="Stratum Website <onboarding@resend.dev>"

# Notion → Insights build pipeline. Copy to .env.local and fill NOTION_TOKEN.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=3de72646-a2a5-41f9-9d23-5208fd336e48
# "Signature CTA" database — feeds the email-signature builder's banner.
# Optional (the sync defaults to this id). The NOTION_TOKEN integration must be
# shared on this database, same as the Stratum News one.
NOTION_CTA_DATA_SOURCE_ID=c24ede1b-5671-46c3-b37d-c56e5516a2ec
