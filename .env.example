# Notion → Insights build pipeline. Copy to .env.local and fill NOTION_TOKEN.
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=3de72646-a2a5-41f9-9d23-5208fd336e48
# "Signature CTA" database — feeds the email-signature builder's banner.
# Optional (the sync defaults to this id). The NOTION_TOKEN integration must be
# shared on this database, same as the Stratum News one.
NOTION_CTA_DATA_SOURCE_ID=c24ede1b-5671-46c3-b37d-c56e5516a2ec
